NODE_ENV=development
PORT=5000

# Must be a replica set (MongoDB Atlas, or `docker compose up mongo` and
# mongodb://localhost:27017/bakiguard?replicaSet=rs0&directConnection=true)
MONGODB_URI=

# Comma-separated browser origins allowed to call the API.
FRONTEND_URL=http://localhost:3000

# At least 32 characters. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30

AI_SERVICE_URL=http://localhost:8000
# Must match the AI service's AI_SERVICE_API_KEY. Optional in development.
AI_SERVICE_API_KEY=
AI_SERVICE_TIMEOUT_MS=5000

# Number of reverse proxies in front of the API (load balancer, nginx).
TRUST_PROXY=0

LOG_LEVEL=info

# SMS gateway for login codes. "console" prints codes to the log (development).
SMS_PROVIDER=console
# Only for local production-mode demos. Never in real production.
ALLOW_CONSOLE_SMS=false
OTP_TTL_MINUTES=5

# "Sign in with Google": OAuth client ID from Google Cloud Console
# (APIs & Services > Credentials > OAuth client ID > Web application).
GOOGLE_CLIENT_ID=

# Phone + OTP login (off until an SMS provider is chosen).
PHONE_LOGIN_ENABLED=false
