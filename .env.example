# Used by docker-compose.yml. Copy to .env and fill in.

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Shared secret between backend and AI service. Generate the same way.
AI_SERVICE_API_KEY=

# Browser origin(s) of the frontend, comma-separated.
FRONTEND_URL=http://localhost:3000

# Public URL of the API as the browser sees it (baked into the frontend build).
PUBLIC_API_URL=http://localhost:5000/api

# Number of reverse proxies in front of the API (0 when exposed directly).
TRUST_PROXY=0

# SMS gateway. "console" + ALLOW_CONSOLE_SMS=true prints login codes in the backend log.
SMS_PROVIDER=console
ALLOW_CONSOLE_SMS=true


# Subscriptions (see backend/.env.example).
BILLING_BKASH_NUMBER=
ADMIN_API_KEY=
